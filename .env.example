# Cambiar por un valor largo y aleatorio antes de exponer el servicio.
JARVIS_API_KEY=

# Ejemplo: Groq. También podés usar otro servidor compatible.
JARVIS_MODEL_BASE_URL=https://api.groq.com/openai/v1
JARVIS_MODEL_API_KEY=
JARVIS_MODEL_NAME=openai/gpt-oss-20b

# Transcripción de voz. Con Groq se usa la misma clave que en MODEL_API_KEY.
JARVIS_STT_BASE_URL=https://api.groq.com/openai/v1
JARVIS_STT_API_KEY=
JARVIS_STT_MODEL=whisper-large-v3-turbo

# Opcional: la página de prueba usa la voz del navegador.
JARVIS_TTS_BASE_URL=
JARVIS_TTS_API_KEY=
JARVIS_TTS_MODEL=
JARVIS_TTS_VOICE=
